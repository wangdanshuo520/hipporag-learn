# Fill the key locally. Do not paste it into chat or commit this file with a key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Small English embedding model for the upstream English sample benchmark.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DEEPSEEK_THINKING=disabled
# Local Qwen through MLX LM's OpenAI-compatible server; no API key needed.
LOCAL_MODEL=mlx-community/Qwen2.5-1.5B-Instruct-4bit
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
