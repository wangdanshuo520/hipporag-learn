{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Check environment (offline)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "scripts/check_environment.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
